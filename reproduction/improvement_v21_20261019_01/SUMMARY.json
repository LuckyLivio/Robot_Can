        "validation/development_gate.json": "0ff51e7726ed39e5afcb183acb0a413aaa7279440c834848c4d1ac8984057c62"
      }
    },
    {
      "title": "A恢复了重定位五帧，但没有提前进入搬运",
      "finding": "6000005两配置的A/完整组在300–302步与实际v19具有相同观测、D2队列和逐位相同命令；首次命令差在304步，首次观测差在307步。精确原输入回放确认，A/完整组和v19均在316–320连续5帧满足原重定位全部条件，320步退出；实际v20仅出现4帧，335步年龄25超过24而撤回。A在320步侧误差7.077mm、固定回中心距离7.890mm，均小于9mm。重定位相关帧（含规划/退出）为v19/place 10、v20 25、A/v21 9；纯PATH_RECENTER命令分别9、23、8。A晚一控制进入重定位、仍同在320步完成，因此少一相关帧不等于任务净省一步；各新组仍328步CLOSE、362步CARRY。",
      "next_step": "保留前三步原反馈作为必要对照，继续使用原9mm、5帧、24步与D2。A可以作为恢复已知重定位进展的候选，但当前证据不支持整体采用或宣称已提高成功率。后续优先处理搬运稳定性和完整阶段预算。",
      "sources": [
        "analysis/smoke_a_handoff_diagnosis.json",
        "analysis/smoke_a_recenter_diagnosis.json",
        "analysis/control_conclusions_a.json"
      ],
      "source_sha256": {
        "analysis/smoke_a_handoff_diagnosis.json": "3e0fc46d11e5bb662b39d956fb6e235c73e66835d995f14d1565011509eefdbe",
        "analysis/smoke_a_recenter_diagnosis.json": "671cdcc24d12299707353a618c92b4439ec51a4e9cf9845f417f20f9493cab1c",
        "analysis/control_conclusions_a.json": "5e284bea37335e3699a3e02586b069fe0f678fbc96a383ec26fa78fc7992a4e6"
      }
    },
    {
      "title": "6000005的瓶颈转到搬运稳定与剩余预算",
      "finding": "A/完整组在364–400执行直接搬运，严格到位区间为387–389三帧、397–400四帧；最大连续帧数由v19的3提高到4，400步位置误差6.084→2.595mm、角误差0.03321→0.02583rad，但仍未满5帧、没有进入PLACE。两配置共享同一物理起点，不能当成两个独立新救回。B严格仅PLACE，在这两配置从未被调用。即使下一步能达到第五帧，也仍有PLACE和RELEASE，不能说整回合只差一步成功，更不能假设400步之后会持续到位。",
      "next_step": "下一候选应提前获得稳定的五帧并为PLACE/RELEASE留出预算：先检查末段实测速度、积分和在途D2命令与出入9mm球的关系，再做独立局部消融。保持400步和原全部阈值，不延长回合、不减少确认帧。",
      "sources": [
        "analysis/smoke_a_handoff_diagnosis.json",
        "analysis/control_conclusions_a.json"
      ],
      "source_sha256": {
        "analysis/smoke_a_handoff_diagnosis.json": "3e0fc46d11e5bb662b39d956fb6e235c73e66835d995f14d1565011509eefdbe",
        "analysis/control_conclusions_a.json": "5e284bea37335e3699a3e02586b069fe0f678fbc96a383ec26fa78fc7992a4e6"
      }
    },
    {
      "title": "只把B放进PLACE没有复现v20的一步释放收益",
      "finding": "12000036中A与v19的400步命令及状态完全相同。B/完整组与v19直到382步保持相同输入轨迹，383步才首次命令不同、386步才首次观测不同；但均391步进入RELEASE，392步提交开爪、D2后394步首次执行，截至400步7次已执行开爪，均失败。实际v20仍390/391/393，尾部8次且400步成功。虽然v19/v20/A/B/完整组均CARRY277、PLACE363及搬运段5/17/55步相同，实际v20与完整v21在PLACE入口EEF位置已差2.630mm、物体位置差2.679mm。390步B/完整组物体高度0.900665m，尚未满足原<0.900m；实际v20为0.899141m，已经满足。B/完整组391步输出标签仍PLACE但实际模式已RELEASE，正确回到父版；该尾帧回退发生在当前释放判据通过之后，不能倒推成390步高度不达标的原因。",
      "next_step": "不要把旧成功简单归因于一个可独立移植的PLACE开关。下一步先对齐并检查PLACE入口位姿、实测速度、抓持相对位姿及在途命令，分别隔离搬运末段与PLACE作用范围；只有经过同条件闭环对照才能判断尾帧规则或控制状态的因果作用。",
      "sources": [
